# LLM provider: mock | anthropic | vllm
LLM_PROVIDER=mock

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# vLLM (Llama 3.3 70B on DGX Spark, OpenAI-compatible endpoint)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Database (sqlite for dev, postgres+asyncpg for prod)
DATABASE_URL=sqlite+aiosqlite:///./agentforge.db

# Runtime caps
MAX_TOOL_CALLS_PER_TURN=10
AGENT_TIMEOUT_SECONDS=60

# Destructive demo-only admin reset. Keep disabled outside local development.
ENABLE_DEMO_RESET=false
